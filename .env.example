# Copiá este archivo a .env y completá. NUNCA subas .env a git.
APP_ENV=development                 # development | production
SECRET_KEY=                         # python -c "import secrets; print(secrets.token_urlsafe(64))"
DATABASE_URL=postgresql://fivox:fivox@localhost:5432/fivox
# DEV_DATABASE_URL=                 # opcional: sobrescribe DATABASE_URL en desarrollo

# Detrás de Nginx/Render/Railway: true (para IP real y https correcto)
TRUST_PROXY=false
# Producción con varios workers: Redis (si no, el límite de intentos es por worker)
RATELIMIT_STORAGE_URI=memory://

# Email (Gmail: usá una "contraseña de aplicación")
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Número de WhatsApp de soporte, con código de país y sin "+"  (ej. 5491155551234)
SUPPORT_WHATSAPP=5491100000000
# true cuando compilás Tailwind (ver README)
USE_COMPILED_CSS=false
